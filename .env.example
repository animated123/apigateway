# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://gateway.errandly.site"

# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_JWKS_URL="https://your-project.supabase.co/jwt/jwks.json"

# Payment Configuration
CALLBACK_URL="https://gateway.errandly.site/api/payments/callback"

# PayHero M-Pesa Configuration
PAYHERO_API_KEY="your-payhero-api-key"
PAYHERO_AUTH="your-payhero-basic-auth-base64"
PAYHERO_USERNAME="your-payhero-username"
PAYHERO_PASSWORD="your-payhero-password"
PAYHERO_SERVICE_ID="your-payhero-service-id"

# Paystack Configuration
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"

# SMS API Configuration (TalkSasa/AfricasTalking)
SMS_API_KEY="your-sms-api-key"
TALKSASA_API_TOKEN="your-talksasa-bearer-token"
SMS_USERNAME="your-sms-username"
SMS_SENDER_ID="your-sender-id"

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Railway API <noreply@yourdomain.com>"

# Authentication Configuration
JWT_SECRET="your-jwt-signing-secret-key"

# Firebase Configuration
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
